server {
    listen 80;
    server_name khalitov.ai-info;
 
    root /var/www/boardy;
    index index.html;
 
    access_log /var/log/nginx/boardy-access.log;
    error_log  /var/log/nginx/boardy-error.log;
 
    location = /submit {
        gzip off;
        fastcgi_pass unix:/var/run/fcgiwrap.socket;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/boardy/cgi-bin/submit.sh;	
     }

    location = /messages.sh {
        gzip off;
        fastcgi_pass unix:/var/run/fcgiwrap.socket;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/boardy/cgi-bin/messages.sh;
     }
 
     location /cgi-bin/ {
    	gzip off;
	root /var/www/boardy;
	fastcgi_pass unix:/var/run/fcgiwrap.socket;
	include fastcgi_params;
	fastcgi_param SCRIPT_FILENAME /var/www/boardy$fastcgi_script_name;
     }


     location / {
        try_files $uri $uri/ =404;
     }
 
     error_page 404 /404.html;
}
