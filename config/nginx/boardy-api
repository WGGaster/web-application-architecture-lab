server {
    listen 80;
    listen 443 ssl;

    server_name api.khalitov.ai-info.ru;

    ssl_certificate /etc/ssl/certs/api-khalitov-ai-info.crt;
    ssl_certificate_key /etc/ssl/private/api-khalitov-ai-info.key;
 
    root /var/www/boardy-api;
    index index.html;
 
    access_log /var/log/nginx/boardy-api-access.log;
    error_log  /var/log/nginx/boardy-api-error.log;	

    location / {
	proxy_pass http://127.0.0.1:8000;
	proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

